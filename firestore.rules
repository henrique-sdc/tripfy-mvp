rules_version = '2';

// Regras de segurança do Firestore (Seção 6.2, item 5).
// Princípio: negar tudo por padrão e liberar apenas o acesso do usuário
// autenticado ao seu próprio documento. O backend usa o Admin SDK, que
// ignora estas regras — então elas protegem exclusivamente o acesso direto
// feito pelo app (client SDK).
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuário só lê/edita o próprio perfil. Billing (tier / premium_until),
    // push (push_devices / notifications_enabled) e create de viagem nova
    // passam só pelo Admin SDK (FastAPI).
    match /users/{uid} {
      function isSelf() {
        return request.auth != null && request.auth.uid == uid;
      }

      allow read: if isSelf();
      // Create pelo client não pode plantiar Pro no doc.
      allow create: if isSelf()
        && !request.resource.data.keys().hasAny([
          'tier',
          'premium_until',
          'push_devices',
          'notifications_enabled',
        ]);
      allow update: if isSelf()
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny([
              'tier',
              'premium_until',
              'push_devices',
              'notifications_enabled',
            ]);
      allow delete: if isSelf();

      // Roteiros — create só via API (limite Free). Restore também: o client
      // não pode zerar deleted_at (senão fura o teto de 2 ativas).
      // Viagem conjunta: membros leem o doc do dono; escrita do miolo só via API.
      match /trips/{tripId} {
        function isMember() {
          return request.auth != null
            && resource.data.member_uids is list
            && request.auth.uid in resource.data.member_uids;
        }

        function soloUpdate() {
          return (!('collab' in resource.data) || resource.data.collab != true)
            && (
              !('deleted_at' in resource.data)
              || resource.data.deleted_at == null
              || request.resource.data.deleted_at != null
            )
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny([
                  'collab',
                  'member_uids',
                  'revision',
                  'recent_op_ids',
                  'last_op_id',
                  'last_op_type',
                  'updated_by',
                  'updated_by_name',
                  'last_change',
                  'last_change_day',
                  'role',
                  'is_public',
                  'published_at',
                  'invite_hash',
                ]);
        }

        // Dono pode mandar a viagem conjunta pra lixeira. O miolo não.
        function ownerTrashCollab() {
          return resource.data.collab == true
            && resource.data.owner_uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['deleted_at', 'updated_at'])
            && request.resource.data.deleted_at != null;
        }

        allow read: if isSelf() || isMember();
        allow create: if false;
        allow delete: if isSelf();
        allow update: if isSelf() && (soloUpdate() || ownerTrashCollab());
      }
    }

    // Sessões Match: o app só observa a própria sala. Toda escrita continua
    // restrita ao backend via Admin SDK (limite, status, lock e itinerary).
    match /matches/{matchId} {
      allow get: if request.auth != null
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;
      allow list, create, update, delete: if false;
    }

    // Avaliações Tripfy por place_id Google — só Admin SDK (API FastAPI).
    match /place_reviews/{reviewId} {
      allow read, write: if false;
    }

    // Dedupe dos pushes. Só o tick (Admin SDK) escreve.
    match /notification_sends/{sendId} {
      allow read, write: if false;
    }

    // Convite de edição — só Admin SDK. O id do doc é o sha256 do token.
    match /trip_invites/{inviteId} {
      allow read, write: if false;
    }

    // Cartão do Explorar. Sem days, notas ou UID. Escrita só pela API.
    match /explore_trips/{tripId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Índice de deep link / clone — client escreve o próprio; leitura só Admin.
    match /trip_shares/{tripId} {
      allow create: if request.auth != null
        && request.resource.data.owner_uid == request.auth.uid
        && request.resource.data.trip_id == tripId;
      // Update não troca o dono — senão outro uid sequestra o deep link.
      allow update: if request.auth != null
        && resource.data.owner_uid == request.auth.uid
        && request.resource.data.owner_uid == request.auth.uid
        && request.resource.data.trip_id == tripId;
      allow delete: if request.auth != null
        && resource.data.owner_uid == request.auth.uid;
      allow read: if false;
    }

    // Qualquer outra coleção fica bloqueada até ganhar regra explícita.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
