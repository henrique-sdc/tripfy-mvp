rules_version = '2';

// Regras de segurança do Firestore (Seção 6.2, item 5).
// Princípio: negar tudo por padrão e liberar apenas o acesso do usuário
// autenticado ao seu próprio documento. O backend usa o Admin SDK, que
// ignora estas regras — então elas protegem exclusivamente o acesso direto
// feito pelo app (client SDK).
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuário só lê/edita o próprio perfil. Billing (tier / premium_until)
    // e create de viagem nova passam só pelo Admin SDK (FastAPI).
    match /users/{uid} {
      function isSelf() {
        return request.auth != null && request.auth.uid == uid;
      }

      allow read: if isSelf();
      // Create pelo client não pode plantiar Pro no doc.
      allow create: if isSelf()
        && !request.resource.data.keys().hasAny(['tier', 'premium_until']);
      allow update: if isSelf()
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['tier', 'premium_until']);
      allow delete: if isSelf();

      // Roteiros — create só via API (limite Free). Restore também: o client
      // não pode zerar deleted_at (senão fura o teto de 2 ativas).
      match /trips/{tripId} {
        allow read: if isSelf();
        allow create: if false;
        allow delete: if isSelf();
        allow update: if isSelf()
          && (
            !('deleted_at' in resource.data)
            || resource.data.deleted_at == null
            || request.resource.data.deleted_at != null
          );
      }
    }

    // Sessões Match: o app só observa a própria sala. Toda escrita continua
    // restrita ao backend via Admin SDK (limite, status, lock e itinerary).
    match /matches/{matchId} {
      allow get: if request.auth != null
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants;
      allow list, create, update, delete: if false;
    }

    // Avaliações Tripfy por place_id Google — só Admin SDK (API FastAPI).
    match /place_reviews/{reviewId} {
      allow read, write: if false;
    }

    // Índice de deep link / clone — client escreve o próprio; leitura só Admin.
    match /trip_shares/{tripId} {
      allow create, update: if request.auth != null
        && request.resource.data.owner_uid == request.auth.uid
        && request.resource.data.trip_id == tripId;
      allow delete: if request.auth != null
        && resource.data.owner_uid == request.auth.uid;
      allow read: if false;
    }

    // Qualquer outra coleção fica bloqueada até ganhar regra explícita.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
